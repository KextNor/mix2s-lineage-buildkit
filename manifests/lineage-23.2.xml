<?xml version="1.0" encoding="UTF-8"?>
<!--
  Xiaomi Mi MIX 2S (polaris) — LineageOS 23.2 (Android 16) local manifest

  为什么不用 LineageOS 官方 polaris 设备树？
  - LineageOS/android_device_xiaomi_polaris 的 lineage-23.2 分支和 lineage-22.2
    是同一个提交，没有为 Android 16 做过适配；
  - 官方 kernel / vendor 也没有 lineage-23.2 分支。

  所以这里改用 Evolution-X 社区仓库的 bka（Android 16 / Baklava）分支：
  它包含 polaris + sdm845-common 设备树、内核、vendor blobs、hardware/xiaomi，
  是当前仍在维护的 A16 组合。全部按 commit SHA 固定，不受上游后续改动影响。

  bka 分支提交时间（2026-11 核对）：
    device/polaris        2025-08-19
    device/sdm845-common  2025-12-10
    kernel                2026-11-11   ← 最新
    vendor blobs          2025-04-13
    hardware/xiaomi       2026-11-01

  注意：这套组合可以用 LineageOS 23.2 源码编译（设备树继承 vendor/lineage），
  但它仍是移植，编译成功 ≠ 日用稳定，必须实机验证。
-->
<manifest>
  <project name="Evolution-X-Devices/device_xiaomi_polaris"
           path="device/xiaomi/polaris"
           remote="github"
           revision="9482c6a9ad73513bc1b3550f1c5d0a86084401f4" />

  <project name="Evolution-X-Devices/device_xiaomi_sdm845-common"
           path="device/xiaomi/sdm845-common"
           remote="github"
           revision="7d482dfe603920d133409ce35325ceaf8ea97fa5" />

  <project name="Evolution-X-Devices/kernel_xiaomi_sdm845"
           path="kernel/xiaomi/sdm845"
           remote="github"
           revision="20537062a7375491151c9f277740708c4dc25076" />

  <project name="Evolution-X-Devices/vendor_xiaomi_polaris"
           path="vendor/xiaomi/polaris"
           remote="github"
           revision="6109f48271a6a2b7b5bac6b9a853fc31be26a228" />

  <project name="Evolution-X-Devices/vendor_xiaomi_sdm845-common"
           path="vendor/xiaomi/sdm845-common"
           remote="github"
           revision="ccf4219fdcac68d1419b28a29ea73434c04a5463" />

  <project name="Evolution-X-Devices/hardware_xiaomi"
           path="hardware/xiaomi"
           remote="github"
           revision="7c4bfbe91dc201bc71302353001d0223f3ef0a79" />
</manifest>
